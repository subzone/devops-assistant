#!/usr/bin/env bash
# Locates or builds the k8sh binary, then execs it.
# Order: plugin bin/k8sh-<os>-<arch> (release), then in a source checkout with Go
# bin/k8sh built from this source (rebuilt when a .go file is newer), then plugin
# bin/k8sh, then k8sh on PATH. A checkout prefers its own source over PATH, which
# may hold another installed version of this plugin's binary.
# If no binary can be found in hook mode, fail CLOSED for k8s-related commands.
set -euo pipefail

ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"; case "$ARCH" in x86_64) ARCH=amd64;; aarch64|arm64) ARCH=arm64;; esac

build() {
  (cd "$ROOT" && CGO_ENABLED=0 go build -trimpath -o "$ROOT/bin/k8sh" ./cmd/k8sh) >&2
}

stale() {
  [ ! -x "$ROOT/bin/k8sh" ] && return 0
  [ -n "$(find "$ROOT/cmd" "$ROOT/internal" "$ROOT/go.mod" -newer "$ROOT/bin/k8sh" \( -name '*.go' -o -name go.mod \) 2>/dev/null | head -n 1)" ]
}

find_bin() {
  [ -x "$ROOT/bin/k8sh-$OS-$ARCH" ] && { echo "$ROOT/bin/k8sh-$OS-$ARCH"; return 0; }
  if [ -f "$ROOT/go.mod" ] && command -v go >/dev/null 2>&1; then
    if ! stale || build; then
      [ -x "$ROOT/bin/k8sh" ] && { echo "$ROOT/bin/k8sh"; return 0; }
    fi
  fi
  [ -x "$ROOT/bin/k8sh" ] && { echo "$ROOT/bin/k8sh"; return 0; }
  command -v k8sh 2>/dev/null && return 0
  return 1
}

if BIN="$(find_bin)"; then
  exec "$BIN" "$@"
fi

if [ "${1:-}" = "hook" ]; then
  input="$(cat)"
  if printf '%s' "$input" | grep -Eqi 'kubectl|helm|argocd|ansible|velero|eksctl|aws eks|az aks|gcloud container|terraform|\.kube|\.aws|\.azure|gcloud|secret|base64|\.k8sh|\.env'; then
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"k8sh guardrail: k8sh binary not installed, failing closed for Kubernetes/credential commands. Install Go 1.24+ or a k8sh release binary (see README)."}}'
  fi
  exit 0
fi

echo "k8sh: binary not found. Install Go 1.24+ (auto-build) or download a release into $ROOT/bin/ (see README)." >&2
exit 1
